# Пуш разрешён только после успешных проверок архитектуры, тестов и сборки.
# Аварийный обход проверки: git push --no-verify

echo "[1/3] Проверка архитектуры FSD (npm run lint:arch)..."
if ! npm run lint:arch; then
  echo ""
  echo "ПУШ ОТМЕНЁН: нарушения архитектуры FSD (steiger)."
  echo "Подробности — в выводе steiger выше."
  echo "Локальная проверка: npm run lint:arch."
  echo "Аварийный обход проверки: git push --no-verify"
  exit 1
fi

echo "[2/3] Запуск тестов (npm run test:run)..."
if ! npm run test:run; then
  echo ""
  echo "ПУШ ОТМЕНЁН: тесты не прошли."
  echo "Подробности — в выводе vitest выше."
  echo "Для отладки: npm run test (watch-режим)."
  echo "Аварийный обход проверки: git push --no-verify"
  exit 1
fi

echo "[3/3] Сборка приложения (npm run build)..."
if ! npm run build; then
  echo ""
  echo "ПУШ ОТМЕНЁН: сборка не прошла."
  echo "Подробности — в выводе выше (чаще всего это ошибки типов tsc -b)."
  echo "Для проверки локально: npm run build."
  echo "Аварийный обход проверки: git push --no-verify"
  exit 1
fi

echo ""
echo "Все проверки пройдены: архитектура, тесты и сборка успешны."
